# corkedfever.com's front door on meteor: every site on the box comes through here.
# Live at /opt/corkedfever/caddy/Caddyfile. Edit here, then from the repo root:
#   scp -i ~/.ssh/meteor deploy/meteor/caddy/Caddyfile root@corkedfever.com:/opt/corkedfever/caddy/Caddyfile
#   ssh -i ~/.ssh/meteor root@corkedfever.com "docker exec corkedfever-caddy caddy validate --config /etc/caddy/Caddyfile && docker exec corkedfever-caddy caddy reload --config /etc/caddy/Caddyfile"
{
	servers :8443 {
		# Aetherstream's HLS listener. libvlc 3 cannot fetch HLS over HTTP/2 — it aborts
		# segments with RST_STREAM — so this listener speaks HTTP/1.1 only.
		protocols h1
	}
}

# -- corkedfever.com ---------------------------------------------------------
# Every site below is a GitHub Pages site proxied under its own name: a git push to the
# repository's docs/ updates it here with nothing to copy onto the box.

corkedfever.com {
	rewrite * /corkedfever-website{path}
	reverse_proxy https://corkedfever.github.io {
		header_up Host corkedfever.github.io
	}
}

www.corkedfever.com {
	redir https://corkedfever.com{uri} permanent
}

memoria.corkedfever.com {
	rewrite * /memoria-emulator{path}
	reverse_proxy https://corkedfever.github.io {
		header_up Host corkedfever.github.io
	}
}

# -- Aetherstream ------------------------------------------------------------
# Its services run in Aetherstream's own stack (/opt/aetherstream) and join the corkedfever
# network, so they are reached here by container name.

aetherstream.corkedfever.com {
	# The party service lives under /party — the plugin joins host and path naively, so
	# "domain/party" typed as the server address is all the routing there is.
	handle_path /party/* {
		# The auth callback is for MediaMTX, which reaches the API directly over its own
		# stack's network. Nobody outside has any business probing it.
		@auth path /auth
		respond @auth 403

		reverse_proxy aether-api:8099
	}

	handle {
		rewrite * /Aetherstream{path}
		reverse_proxy https://corkedfever.github.io {
			header_up Host corkedfever.github.io
		}
	}
}

aetherstream.corkedfever.com:8443 {
	reverse_proxy aether-stream:8888
}
